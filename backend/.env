# ── Database ──────────────────────────────────────────────
DATABASE_URL=sqlite:///./app/db/degree_verify.db

# ── Excel roster path (relative to project root) ─────────
EXCEL_ROSTER_PATH=Degree Verification_Convocation 2026 (1).xlsx

# ── Tesseract OCR ────────────────────────────────────────
# Update this path if Tesseract is installed elsewhere
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Upload directory ─────────────────────────────────────
UPLOAD_DIR=./uploads

# ── Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Frontend URL (for CORS) ─────────────────────────────
FRONTEND_URL=http://localhost:5173
